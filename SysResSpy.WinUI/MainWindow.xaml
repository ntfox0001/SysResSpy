<Window
    x:Class="SysResSpy.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysResSpy.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="5*" MinWidth="470"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="6*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: process list ===== -->
            <Grid Grid.Column="0" Padding="10,10,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="进程列表" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="AskDoubaoBtn" Content="问豆包"
                            Margin="10,0,0,0" Padding="8,2" Click="OnAskDoubao"/>
                    <ToggleButton Grid.Column="2" x:Name="GroupToggle"
                                  HorizontalAlignment="Right"
                                  Margin="10,0,0,0" Padding="8,2"
                                  Content="按名称分组" IsChecked="False"
                                  Checked="OnGroupToggled" Unchecked="OnGroupToggled"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderBar" Grid.Row="0" Padding="8,6,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HdrName" Grid.Column="0"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortName">
                            <TextBlock x:Name="TxtName" Text="进程  ▲" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <Button x:Name="HdrPid" Grid.Column="1"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortPid">
                            <TextBlock x:Name="TxtPid" Text="PID" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <Button x:Name="HdrCpu" Grid.Column="2"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortCpu">
                            <TextBlock x:Name="TxtCpu" Text="CPU%" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <Button x:Name="HdrMem" Grid.Column="3"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortMem">
                            <TextBlock x:Name="TxtMem" Text="内存" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <Button x:Name="HdrCpuPeak" Grid.Column="4"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortCpuPeak">
                            <TextBlock x:Name="TxtCpuPeak" Text="CPU峰值" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <Button x:Name="HdrMemPeak" Grid.Column="5"
                                Padding="0" HorizontalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Click="OnSortMemPeak">
                            <TextBlock x:Name="TxtMemPeak" Text="内存峰值" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                    </Grid>

                    <ListView x:Name="ProcessList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnSelectionChanged"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="MinHeight" Value="30"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProcessRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind PidText, Mode=OneWay}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind MemText, Mode=OneWay}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind CpuPeakText, Mode=OneWay}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind MemPeakText, Mode=OneWay}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- divider -->
            <Border Grid.Column="1" Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- ===== RIGHT: charts ===== -->
            <Grid Grid.Column="2" Padding="8,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <local:AreaChart x:Name="CpuChart" Grid.Row="0"/>
                <local:AreaChart x:Name="MemChart" Grid.Row="2"/>
            </Grid>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="1" Padding="12,4"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>